dist
# Installer build output (setup executables)
installer/dist
# Staged package data is regenerated by the installer build script
installer/source/packages/druppc/data/
# License texts copied into meta/ by the installer build script (source of truth: installer/other/license)
installer/source/packages/druppc/meta/license-*.txt
# Installer icon copied from src/resource/icon/main.ico by the installer build script
installer/source/config/druppc_setup.ico
# Large font binaries are shipped outside the repo
src/resource/font/*.otf
src/resource/font/**/*.otf
